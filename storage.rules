rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Permitir fotos de perfil de usuarios (docentes, directores, especialistas)
    match /usuarios/{dni}/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 500 * 1024 && request.resource.contentType.matches('image/.*');
    }

    // Permitir fotos carnet de estudiantes en el storage central
    match /estudiantes/{dni}/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 500 * 1024 && request.resource.contentType.matches('image/.*');
    }

    // Permitir fotos carnet de estudiantes asociadas a la nómina de un docente
    match /usuarios/{dniDocente}/estudiantes/{dniEstudiante}/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 500 * 1024 && request.resource.contentType.matches('image/.*');
    }

    // Permitir a usuarios autenticados subir y leer archivos en excel-exports/
    match /excel-exports/{fileName} {
      allow read, write: if request.auth != null;
    }

    // Permitir a usuarios autenticados subir y leer evidencias
    match /evidencias_especialistas/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Permitir a usuarios autenticados subir y leer capturas de la pizarra
    match /pizarras_capturas/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Permitir lectura pública de los banners institucionales y subida a usuarios autenticados
    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Permitir acceso a otras carpetas según sea necesario
    match /{allPaths=**} {
      allow read, write: if false; // Denegar acceso por defecto a otras rutas
    }
  }
}


